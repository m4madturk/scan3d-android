<?xml version="1.0" encoding="utf-8"?>
<!-- Capture screen: the camera is the screen. One instruction, one big shutter, everything else behind "more". -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <!-- top bar: what am I doing (mode), progress, help, more -->
    <LinearLayout android:id="@+id/topBar"
        android:layout_width="0dp" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:layoutDirection="rtl"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/modeChip" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center"
            android:background="@drawable/bg_chip" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold" android:text="@string/mode_scan" />
        <TextView android:id="@+id/count" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:textColor="@color/text_dim" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/btnHelp" android:layout_width="38dp" android:layout_height="38dp" android:gravity="center"
            android:background="@drawable/bg_circle" android:text="@string/help" android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold"
            android:contentDescription="@string/cd_help" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/btnMore" android:layout_width="38dp" android:layout_height="38dp" android:gravity="center"
            android:background="@drawable/bg_circle" android:text="@string/more_dots" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold"
            android:contentDescription="@string/cd_more" />
    </LinearLayout>

    <!-- camera preview: everything between the top bar and the controls -->
    <androidx.camera.view.PreviewView android:id="@+id/preview"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar" app:layout_constraintBottom_toTopOf="@id/panel"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fitCenter" />

    <ir.scan3d.app.OverlayView android:id="@+id/overlay"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview" app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview" app:layout_constraintEnd_toEndOf="@id/preview" />

    <!-- live pose read-out, small, top-left of the picture -->
    <TextView android:id="@+id/live" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:layout_marginLeft="8dp"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"
        android:background="@drawable/bg_pill" android:textColor="#FFFFFF" android:textSize="12sp" android:textDirection="rtl"
        android:text="@string/starting"
        app:layout_constraintTop_toTopOf="@id/preview" app:layout_constraintLeft_toLeftOf="@id/preview" />

    <!-- what just happened (photo saved / blurred / board missing): a pill over the picture that fades away -->
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="10dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp"
        android:background="@drawable/bg_pill" android:textColor="#FFFFFF" android:textSize="13sp" android:textDirection="rtl" android:gravity="center"
        android:maxLines="2" android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/preview" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <!-- controls -->
    <LinearLayout android:id="@+id/panel" android:orientation="vertical"
        android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/bg"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="4dp" android:layoutDirection="rtl"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <!-- guidance: 3D view of where to hold the phone + what the next photo is + how to move -->
        <LinearLayout android:id="@+id/hintBox"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/bg_card" android:padding="6dp">
            <ir.scan3d.app.GuideView android:id="@+id/guide" android:layout_width="96dp" android:layout_height="96dp" android:contentDescription="@string/cd_guide" />
            <LinearLayout android:id="@+id/hintTexts" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/next" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/text" android:textSize="14sp" android:lineSpacingExtra="1dp" android:maxLines="3" android:ellipsize="end" />
                <TextView android:id="@+id/move" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp"
                    android:textColor="@color/warn" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- what the camera sees right now -->
        <LinearLayout android:id="@+id/chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="8dp">
            <TextView android:id="@+id/chipBoard" style="@style/Scan3D.Chip" />
            <TextView android:id="@+id/chipStickers" style="@style/Scan3D.Chip" />
            <TextView android:id="@+id/chipSteady" style="@style/Scan3D.Chip" />
            <TextView android:id="@+id/chipLock" style="@style/Scan3D.Chip" />
        </LinearLayout>

        <!-- appears once there are enough photos; sits above the shutter so the shutter never moves -->
        <Button android:id="@+id/btnBuild" style="@style/Scan3D.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="@string/build_model" android:visibility="gone" />

        <!-- photos so far | shutter | automatic -->
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="2dp">
            <ir.scan3d.app.ShutterView android:id="@+id/btnShot" android:layout_width="76dp" android:layout_height="76dp" android:contentDescription="@string/shoot"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
            <LinearLayout android:id="@+id/btnShots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="4dp"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent">
                <ImageView android:id="@+id/lastThumb" android:layout_width="52dp" android:layout_height="52dp" android:scaleType="centerCrop" android:background="@drawable/bg_card_hi" android:contentDescription="@string/shots_title" />
                <TextView android:id="@+id/shotCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="4dp"
                    android:textColor="@color/text" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/btnAuto" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center"
                android:background="@drawable/bg_toggle" android:textColor="@color/toggle_text" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:text="@string/auto_off" android:textSize="14sp"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

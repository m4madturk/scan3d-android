<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0F1513">

    <!-- camera preview fills everything above the control panel -->
    <androidx.camera.view.PreviewView android:id="@+id/preview"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/panel"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fitCenter" />

    <ir.scan3d.app.OverlayView android:id="@+id/overlay"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview" app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview" app:layout_constraintEnd_toEndOf="@id/preview" />

    <!-- live detection counter; its top margin grows by the status-bar height at runtime -->
    <TextView android:id="@+id/live" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:layout_marginLeft="10dp"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:background="@drawable/bg_pill" android:textColor="#FFFFFF" android:textSize="13sp" android:layoutDirection="rtl"
        android:text="@string/starting"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintLeft_toLeftOf="parent" />

    <!-- the panel may take at most the lower 50 % of the screen; beyond that it scrolls -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guide" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.50" />

    <androidx.core.widget.NestedScrollView android:id="@+id/panel"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:background="#0F1513" android:fillViewport="false"
        app:layout_constrainedHeight="true" app:layout_constraintVertical_bias="1"
        app:layout_constraintTop_toTopOf="@id/guide" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:id="@+id/panelInner" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layoutDirection="rtl">

            <TextView android:id="@+id/next" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_hint" android:textColor="#E5ECE8" android:padding="10dp" android:textSize="14sp" android:lineSpacingExtra="2dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp" android:gravity="center_vertical">
                <TextView android:id="@+id/count" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E5ECE8" android:textSize="15sp" />
                <TextView android:id="@+id/proto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#93A29B" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#93A29B" android:textSize="12sp" android:text="@string/starting" />

            <RadioGroup android:id="@+id/modeSel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <RadioButton android:id="@+id/mode18" style="@style/Scan3D.Radio" android:checked="true" android:text="@string/mode18" />
                <RadioButton android:id="@+id/mode8" style="@style/Scan3D.Radio" android:text="@string/mode8" />
                <RadioButton android:id="@+id/modeFree" style="@style/Scan3D.Radio" android:text="@string/modeFree" />
            </RadioGroup>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <CheckBox android:id="@+id/convex" style="@style/Scan3D.Radio" android:checked="true" android:text="@string/convex" />
                <TextView android:id="@+id/profile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:textColor="#93A29B" android:textSize="11sp" android:paddingStart="8dp" android:paddingEnd="8dp" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnShot" style="@style/Scan3D.Button" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:text="@string/shoot" />
                <Button android:id="@+id/btnAuto" style="@style/Scan3D.Button.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/auto_off" />
                <Button android:id="@+id/btnLock" style="@style/Scan3D.Button.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/lock" />
                <Button android:id="@+id/btnTorch" style="@style/Scan3D.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/torch" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnBuild" style="@style/Scan3D.Button" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:text="@string/build_model" />
                <Button android:id="@+id/btnResult" style="@style/Scan3D.Button.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/result" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnNew" style="@style/Scan3D.Button.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/new_scan" />
                <Button android:id="@+id/btnMode" style="@style/Scan3D.Button.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/to_calib" />
                <Button android:id="@+id/btnSessions" style="@style/Scan3D.Button.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/sessions" />
            </LinearLayout>
            <TextView android:id="@+id/sid" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#5B6862" android:textSize="11sp" android:fontFamily="monospace" android:textDirection="ltr" android:gravity="start" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

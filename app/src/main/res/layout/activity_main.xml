<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0F1513">

    <androidx.camera.view.PreviewView android:id="@+id/preview"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/panel"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fitCenter" />

    <ir.scan3d.app.OverlayView android:id="@+id/overlay"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview" app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview" app:layout_constraintEnd_toEndOf="@id/preview" />

    <TextView android:id="@+id/live" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_margin="10dp" android:padding="6dp" android:background="#88000000" android:textColor="#FFFFFF" android:textSize="13sp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout android:id="@+id/panel" android:orientation="vertical"
        android:layout_width="0dp" android:layout_height="wrap_content" android:padding="10dp" android:layoutDirection="rtl"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <TextView android:id="@+id/next" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#143A37" android:textColor="#E5ECE8" android:padding="8dp" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp">
            <TextView android:id="@+id/count" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#E5ECE8" android:textSize="15sp" />
            <TextView android:id="@+id/proto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#93A29B" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/lastShot" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#93A29B" android:textSize="12sp" android:fontFamily="monospace" android:textDirection="ltr" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#93A29B" android:textSize="12sp" android:text="@string/starting" />

        <RadioGroup android:id="@+id/modeSel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/mode18" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/mode18" android:textColor="#E5ECE8" />
            <RadioButton android:id="@+id/mode8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mode8" android:textColor="#E5ECE8" />
            <RadioButton android:id="@+id/modeFree" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/modeFree" android:textColor="#E5ECE8" />
            <CheckBox android:id="@+id/convex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/convex" android:textColor="#E5ECE8" />
        </RadioGroup>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnShot" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:text="@string/shoot" />
            <Button android:id="@+id/btnAuto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/auto_off" style="?attr/materialButtonOutlinedStyle" />
            <Button android:id="@+id/btnLock" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/lock" style="?attr/materialButtonOutlinedStyle" />
            <Button android:id="@+id/btnTorch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/torch" style="?attr/materialButtonOutlinedStyle" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnBuild" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:text="@string/build_model" />
            <Button android:id="@+id/btnResult" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/result" style="?attr/materialButtonOutlinedStyle" />
            <Button android:id="@+id/btnNew" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/new_scan" style="?attr/materialButtonOutlinedStyle" />
            <Button android:id="@+id/btnMode" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/to_calib" style="?attr/materialButtonOutlinedStyle" />
            <Button android:id="@+id/btnSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙" style="?attr/materialButtonOutlinedStyle" />
        </LinearLayout>
        <TextView android:id="@+id/sid" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#5B6862" android:textSize="11sp" android:fontFamily="monospace" android:textDirection="ltr" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Result: the model to turn around, its dimensions with their repeatability, what to watch out for, the files. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/bg" android:layoutDirection="rtl">

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
        <TextView android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:background="@drawable/bg_circle"
            android:text="@string/back_arrow" android:textColor="@color/text" android:textSize="20sp" android:contentDescription="@string/back" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:textColor="@color/text" android:textSize="19sp" android:textStyle="bold" />
    </LinearLayout>

    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="16dp">

        <!-- progress / failure -->
        <LinearLayout android:id="@+id/stateCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp">
            <TextView android:id="@+id/state" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/stateMsg" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:textColor="@color/text_dim" android:textSize="14sp" />
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:max="100" android:indeterminate="true" android:progressTint="@color/accent" android:indeterminateTint="@color/accent" android:progressBackgroundTint="@color/outline" />
            <TextView android:id="@+id/hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:textColor="@color/text_faint" android:textSize="12sp" android:lineSpacingExtra="2dp" android:text="@string/bg_hint" />
        </LinearLayout>

        <!-- the model -->
        <FrameLayout android:id="@+id/viewerBox" android:layout_width="match_parent" android:layout_height="300dp" android:background="@color/surface" android:visibility="gone">
            <ir.scan3d.app.ModelView android:id="@+id/model" android:layout_width="match_parent" android:layout_height="match_parent" />
            <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="@string/result" />
            <LinearLayout android:id="@+id/tabs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="8dp" android:orientation="horizontal">
                <TextView android:id="@+id/tabClean" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_toggle" android:textColor="@color/toggle_text" android:textSize="13sp" android:text="@string/tab_clean" />
                <TextView android:id="@+id/tabRaw" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:background="@drawable/bg_toggle" android:textColor="@color/toggle_text" android:textSize="13sp" android:text="@string/tab_raw" />
            </LinearLayout>
            <TextView android:id="@+id/viewerHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="6dp"
                android:textColor="@color/text_faint" android:textSize="11sp" android:text="@string/viewer_hint" />
        </FrameLayout>

        <!-- dimensions -->
        <LinearLayout android:id="@+id/dimsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginTop="10dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/dimsTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/text_dim" android:textSize="13sp" android:text="@string/dims_title" />
                <TextView android:id="@+id/grade" style="@style/Scan3D.Chip" android:layout_marginEnd="0dp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/dimA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="26sp" android:textStyle="bold" />
                    <TextView android:id="@+id/dimAs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent" android:textSize="12sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_dim" android:textSize="12sp" android:text="@string/dim_length" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/dimB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="26sp" android:textStyle="bold" />
                    <TextView android:id="@+id/dimBs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent" android:textSize="12sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_dim" android:textSize="12sp" android:text="@string/dim_width" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/dimC" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="26sp" android:textStyle="bold" />
                    <TextView android:id="@+id/dimCs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent" android:textSize="12sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_dim" android:textSize="12sp" android:text="@string/dim_height" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/dimsNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:textColor="@color/text_dim" android:textSize="13sp" android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- calibration numbers -->
        <LinearLayout android:id="@+id/calibCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginTop="10dp" android:visibility="gone">
            <TextView android:id="@+id/calibHead" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/calibBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="@color/text_dim" android:textSize="14sp" android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- what to watch out for -->
        <LinearLayout android:id="@+id/warnCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginTop="10dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/warn" android:textSize="13sp" android:textStyle="bold" android:text="@string/warn_title" />
            <TextView android:id="@+id/warnings" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:textColor="@color/text" android:textSize="14sp" android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <Button android:id="@+id/btnShareClean" style="@style/Scan3D.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/share_clean" android:visibility="gone" />
        <Button android:id="@+id/btnShare" style="@style/Scan3D.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/share_stl" android:visibility="gone" />

        <!-- technical details, folded away -->
        <LinearLayout android:id="@+id/detailsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:layout_marginTop="12dp">
            <TextView android:id="@+id/btnDetails" style="@style/Scan3D.SheetRow" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/text_dim" android:textSize="14sp" android:text="@string/details_show" />
            <LinearLayout android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="12dp" android:visibility="gone">
                <TextView android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_dim" android:textSize="13sp" android:lineSpacingExtra="4dp" />
                <Button android:id="@+id/btnExport" style="@style/Scan3D.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/export_session" />
                <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="@color/text_faint" android:fontFamily="monospace" android:textDirection="ltr" android:gravity="start" android:textSize="10sp" android:textIsSelectable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
